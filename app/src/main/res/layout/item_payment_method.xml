<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_option_selectable"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md">

    <ImageView
        android:id="@+id/ivMethodIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_gray"
        android:contentDescription="@null"
        android:padding="6dp"
        android:src="@drawable/ic_wallet" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMethodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ví điện tử MoMo"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMethodBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_red_soft"
                android:paddingHorizontal="4dp"
                android:text="Hoàn 5%"
                android:textColor="@color/red_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMethodSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Liên kết 0918 •••• 882"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

    <RadioButton
        android:id="@+id/rbMethodSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false" />
</LinearLayout>
