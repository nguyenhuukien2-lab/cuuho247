<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvVerifiedBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_red_soft"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="4dp"
            android:text="🛡 Đối tác xác thực 5 sao"
            android:textColor="@color/red_primary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvExtraBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pill_blue_light"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="4dp"
            android:text="⚡ Có sạc xe điện"
            android:textColor="@color/blue_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivProviderPhoto"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_rounded_dark"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProviderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đội Cứu Hộ 116 Hà Nội"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProviderRatingMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⭐ 4.9 (1.2k đánh giá) • Chuyên nghiệp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProviderDistance"
                    style="@style/MetaPill"
                    android:text="🚗 1.8 km" />

                <TextView
                    android:id="@+id/tvProviderEta"
                    style="@style/MetaPill"
                    android:layout_marginStart="4dp"
                    android:text="⏱ 8 phút tới" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/flexCapabilities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:orientation="horizontal">

        <TextView style="@style/MetaPill" android:text="🛞 Xe sàn trượt" />
        <TextView style="@style/MetaPill" android:layout_marginStart="4dp" android:text="🔧 Lốp tubeless" />
        <TextView style="@style/MetaPill" android:layout_marginStart="4dp" android:text="🔋 Kích bình" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Giá trọn gói ước tính"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvProviderPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="350.000 VNĐ"
                android:textColor="@color/red_primary"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnChooseProvider"
            style="@style/Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_md"
            android:text="@string/btn_choose_team"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
