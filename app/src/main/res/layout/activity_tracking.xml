<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ResQ247  24/7"
                android:textColor="@color/red_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_title"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_red"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="8dp"
            android:text="@string/hotline_number"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_circle_red"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_person"
            app:tint="@color/white" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_rounded_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Bản đồ theo dõi hành trình cứu hộ"
            android:textColor="@color/white"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_navigation"
                app:tint="@color/blue_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTrackingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tracking_on_way"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTrackingEta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏱ Dự kiến 7 phút • Cách 1.4 km"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRecenterTrackingMap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:background="@drawable/bg_pill_white"
            android:contentDescription="@null"
            android:src="@drawable/ic_my_location" />
    </FrameLayout>

    <!-- Bottom sheet content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_rounded_surface"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="● Đội cứu hộ đang tiếp cận"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIncidentCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_blue_light"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="4dp"
                android:text="MÃ SỰ CỐ: #RQ-8842"
                android:textColor="@color/blue_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <include layout="@layout/item_tracking_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_rounded_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md">

            <ImageView
                android:id="@+id/ivTechnicianPhoto"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_gray"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTechnicianName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nguyễn Văn Tuấn"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kỹ thuật viên bậc 4/5 • ResQ Cơ động"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_xs" />

                <TextView
                    android:id="@+id/tvTechnicianPlate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_pill_blue_light"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="29C-774.82  Xe sàn trượt Isuzu"
                    android:textColor="@color/blue_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 4.9 (920)"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCallTechnician"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:backgroundTint="@color/blue_primary"
                android:text="@string/btn_call_tech"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnMessageTechnician"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_outline"
                android:text="@string/btn_message"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dịch vụ đang điều phối"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_red_soft"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Cứu hộ khẩn cấp"
                    android:textColor="@color/red_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🛞 Thay lốp dự phòng ô tô + Bơm khí ni-tơ"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xe Sedan 5 chỗ • Lốp trước bên phụ xì hơi"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_pill_red_soft"
                android:padding="@dimen/spacing_sm"
                android:text="⚠ Hãy bật đèn hazard, đặt tam giác cảnh báo cách xe 50m và đứng an toàn sau lan can đường."
                android:textColor="@color/red_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShareLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_blue_light"
                android:text="@string/btn_share_location"
                android:textColor="@color/blue_primary" />

            <Button
                android:id="@+id/btnCancelRequest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_red_soft"
                android:text="@string/btn_cancel_request"
                android:textColor="@color/red_primary" />
        </LinearLayout>

    </LinearLayout>

    <include layout="@layout/bottom_nav_bar" />

</LinearLayout>
