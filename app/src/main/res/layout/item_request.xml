<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvServiceIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="@dimen/text_md" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRequestService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kích bình ắc quy"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRequestDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="24/10/2024"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRequestStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_green_soft"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="2dp"
            android:text="✓ Đã xong"
            android:textColor="@color/success_green"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRequestVehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Mazda CX-5 • 30H-889.26"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_xs" />

    <TextView
        android:id="@+id/tvRequestLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="📍 Hầm B2 Vincom Mega Mall Royal City, 72A Nguyễn Trãi, Thanh Xuân, Hà Nội"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_xs" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chi phí dịch vụ"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvRequestCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="120.000đ  MOMO"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Đánh giá của bạn"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvRequestRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="⭐⭐⭐⭐⭐ 5.0"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEInvoice"
            style="@style/MetaPill"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🧾 Hóa đơn điện tử" />

        <TextView
            android:id="@+id/btnRebookProvider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="2"
            android:background="@drawable/bg_pill_blue_light"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="🔄 Đặt lại đội này"
            android:textColor="@color/blue_primary"
            android:textSize="@dimen/text_xs"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
