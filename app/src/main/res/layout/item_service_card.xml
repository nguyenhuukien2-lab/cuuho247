<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivServiceIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_rounded_red_soft"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_tire" />

        <TextView
            android:id="@+id/tvServiceBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_blue_light"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="15-20 Phút"
            android:textColor="@color/blue_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvServiceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="Vá vỏ / Thay lốp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_sm"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvServiceDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xử lý lốp cán đinh, nổ lốp, thay lốp sơ-cua"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="Chỉ từ"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tvServicePrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="150.000đ"
        android:textColor="@color/red_primary"
        android:textSize="@dimen/text_sm"
        android:textStyle="bold" />
</LinearLayout>
